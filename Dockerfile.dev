FROM php:8.5-cli

ARG HOST_UID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip curl \
        libgd-dev libwebp-dev libjpeg-dev libfreetype6-dev \
        libpq-dev libsqlite3-dev libzip-dev libicu-dev \
    && docker-php-ext-configure gd --with-webp --with-jpeg --with-freetype \
    && docker-php-ext-install gd pdo_pgsql pdo_sqlite zip intl sockets pcntl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer/composer:2-bin /composer /usr/bin/composer

COPY --from=node:22 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22 /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && corepack enable pnpm

WORKDIR /var/www

VOLUME [ \
    "/var/www/storage", "/var/www/app", \
    "/var/www/resources", "/var/www/routes" \
    ]

RUN chown www-data /var/www && chmod 700 /var/www && usermod -u $HOST_UID www-data
USER www-data

# Copy dependency manifests first for layer caching
COPY --chown=www-data composer.json composer.lock ./
RUN composer install --no-autoloader

COPY --chown=www-data package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# Pest browser tests drive a real chromium via playwright.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
USER root
# TLS-intercepting networks (e.g. WARP) can pass their CA via
# `docker build --secret id=warp_ca,src=<ca.pem>`; untouched otherwise.
RUN --mount=type=secret,id=warp_ca,target=/run/warp_ca.pem,required=false \
    if [ -f /run/warp_ca.pem ]; then export NODE_EXTRA_CA_CERTS=/run/warp_ca.pem; fi; \
    pnpm exec playwright install --with-deps chromium && chmod -R a+rX /opt/ms-playwright
USER www-data

COPY --chown=www-data . .

RUN composer dumpautoload && php artisan storage:link || true

COPY --chown=www-data ./etc/php/php.ini /usr/local/etc/php/conf.d/php.ini

EXPOSE 8000
EXPOSE 5173

# Configuration comes from compose's environment block
CMD pnpm run dev & php artisan serve --host=0.0.0.0 --port=${PORT:-8000}
