        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "wrangler": "^4.131.1"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "sortablejs": "^1.15.7",
        "workers-php": "file:../workers-php/packages/workers-php"
    }
