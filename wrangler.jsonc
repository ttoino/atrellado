{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atrellado",
	"account_id": "e024e5a1e487a3d3a07815b431986107",
	"main": "worker.ts",
	"compatibility_date": "2026-09-13",
	"observability": {
		"enabled": true,
		"logs": { "enabled": true },
		"traces": { "enabled": true }
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "atrellado-files"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "eb0e3247a091442fb2271e3612421c60"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["noreply@atrellado.toino.pt"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atrellado-db",
			"database_id": "7192fb5e-aaa0-4926-8aea-639a3bf4656b"
		}
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["AtrelladoContainer"] },
		{ "tag": "v2", "deleted_classes": ["AtrelladoContainer"] }
	],
	"workers_dev": true,
	"vars": {
		"APP_ENV": "production"
	},
	"rules": [
		{ "type": "Text", "globs": ["**/*.php"], "fallthrough": true }
	]
}
