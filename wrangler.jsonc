{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "atrellado",
    "account_id": "e024e5a1e487a3d3a07815b431986107",
    "main": "worker.ts",
    "compatibility_date": "2026-09-15",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
        "logs": { "enabled": true },
        "traces": { "enabled": true },
    },
    "secrets": { "required": ["APP_KEY", "REVERB_APP_SECRET"] },
    "upload_source_maps": true,
    "vars": { "APP_CACHE_DRIVER": "kv", "APP_QUEUE_CONNECTION": "cfqueue" },
    "workers_dev": true,
    "routes": [{ "custom_domain": true, "pattern": "atrellado.toino.pt" }],
    "containers": [
        {
            "name": "atrellado",
            "class_name": "AtrelladoContainer",
            "image": "./Dockerfile.containers",
            "max_instances": 2,
            "instance_type": "basic",
        },
        {
            "name": "atrellado-reverb",
            "class_name": "ReverbContainer",
            "image": "./Dockerfile.containers",
            "max_instances": 1,
            "instance_type": "lite",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "CONTAINER",
                "class_name": "AtrelladoContainer",
            },
            {
                "name": "REVERB_CONTAINER",
                "class_name": "ReverbContainer",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AtrelladoContainer"],
        },
        {
            "tag": "v2",
            "new_sqlite_classes": ["ReverbContainer"],
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "atrellado",
            "database_id": "a4e9158a-a9f2-4a74-afb2-04c13a2df151",
        },
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "atrellado",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "600a1bfb94b240af9a3e8e094e103fe7",
        },
    ],
    "queues": {
        "producers": [{ "binding": "QUEUE", "queue": "atrellado" }],
        "consumers": [
            { "queue": "atrellado", "max_batch_size": 5, "max_retries": 3 },
        ],
    },
    "triggers": { "crons": ["0 0 * * *"] },
    "send_email": [
        {
            "name": "EMAIL",
            "allowed_sender_addresses": ["noreply@atrellado.toino.pt"],
        },
    ],
    // Previews inherit nothing from production: bindings must be
    // redeclared here (containers too) and point at the atrellado-previews
    // resources. Queue consumers and Cron Triggers target production only,
    // so previews run the queue synchronously and cache on local disk.
    "previews": {
        "vars": {
            "APP_CACHE_DRIVER": "file",
            "APP_QUEUE_CONNECTION": "sync",
        },
        "containers": [
            {
                "class_name": "AtrelladoContainer",
                "image": "./Dockerfile.containers",
                "max_instances": 2,
                "instance_type": "basic",
            },
            {
                "class_name": "ReverbContainer",
                "image": "./Dockerfile.containers",
                "max_instances": 1,
                "instance_type": "lite",
            },
        ],
        "durable_objects": {
            "bindings": [
                {
                    "name": "CONTAINER",
                    "class_name": "AtrelladoContainer",
                },
                {
                    "name": "REVERB_CONTAINER",
                    "class_name": "ReverbContainer",
                },
            ],
        },
        "d1_databases": [
            {
                "binding": "DB",
                "database_name": "atrellado-previews",
                "database_id": "85119855-47ba-497d-a9f3-e72cd8ecb1be",
            },
        ],
        "kv_namespaces": [
            {
                "binding": "KV",
                "id": "a4b28e2c59c84c3ea94d3b1e94f57262",
            },
        ],
        "r2_buckets": [
            {
                "binding": "FILES",
                "bucket_name": "atrellado-previews",
            },
        ],
        "queues": {
            "producers": [
                { "binding": "QUEUE", "queue": "atrellado-previews" },
            ],
        },
        "send_email": [
            {
                "name": "EMAIL",
                "allowed_sender_addresses": ["noreply@atrellado.toino.pt"],
            },
        ],
    },
}
