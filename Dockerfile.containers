FROM dunglas/frankenphp:1-php8.5 AS base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libgd-dev libwebp-dev libjpeg-dev libfreetype6-dev \
        libpq-dev libsqlite3-dev libzip-dev libicu-dev \
    && docker-php-ext-configure gd --with-webp --with-jpeg --with-freetype \
    && docker-php-ext-install gd pdo_pgsql zip intl pcntl \
    && apt-get purge -y \
        libgd-dev libwebp-dev libjpeg-dev libfreetype6-dev \
        libpq-dev libsqlite3-dev libzip-dev libicu-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# FrankenPHP docs' production baseline; app overrides land in conf.d.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --from=composer/composer:2-bin /composer /usr/bin/composer

FROM node:22 AS assets

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable pnpm && pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

FROM base

# workers-php reads APP_DIR for its internal scripts; the app lives in /var/www.
ENV APP_DIR=/var/www

WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-autoloader --no-scripts \
    && rm -rf /root/.composer/cache

COPY . .
COPY --from=assets /app/public/build public/build

# Secrets and environment come from the container runtime, never the image.
RUN composer dumpautoload --optimize \
    && rm -f .env .env.* \
    && chown -R www-data:www-data storage bootstrap/cache

COPY ./etc/php-overrides.ini /usr/local/etc/php/conf.d/atrellado.ini

# workers-php runtime files ship inside the npm package.
COPY --from=assets /app/node_modules/workers-php/etc/entrypoint.sh /entrypoint.sh
COPY --from=assets /app/node_modules/workers-php/etc/Caddyfile /etc/caddy/Caddyfile
COPY --from=assets /app/node_modules/workers-php/etc/queue-consumer.php /usr/local/bin/queue-consumer.php
COPY --from=assets /app/node_modules/workers-php/etc/schedule-runner.php /usr/local/bin/schedule-runner.php
RUN chmod +x /entrypoint.sh

# Laravel Pulse writes to a sqlite database.
RUN mkdir -p database && touch database/pulse.sqlite

ENV SERVER_NAME=:8080

EXPOSE 8080
EXPOSE 8081

ENTRYPOINT ["/entrypoint.sh"]
